{
  "name": "@semyonf/kamchazky",
  "version": "0.2.0",
  "author": "Semyón <taxnuke@gmail.com>",                                                                                                   
  "homepage": "https://github.com/semyonf/kamchazky#readme",                                                                                
  "bugs": { "url": "https://github.com/semyonf/kamchazky/issues" },
  "description": "Type-safe Result and Maybe monads for TypeScript. Explicit error handling and optional values with full type inference. No exceptions required.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:types": "vitest typecheck --run test/result.test-d.ts test/maybe.test-d.ts",
    "typecheck": "tsc",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "result",
    "maybe",
    "option",
    "monad",
    "typescript",
    "error-handling",
    "functional",
    "either",
    "oxide"
  ],
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/semyonf/kamchazky.git"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.10",
    "@tsconfig/node20": "20.1.9",
    "@tsconfig/strictest": "2.0.8",
    "tsup": "8.0.0",
    "typescript": "5.9.3",
    "vitest": "3.0.0"
  }
}
