{
  "name": "@semyonf/camtschaticus",
  "version": "0.1.0",
  "description": "Type-safe Result monad for TypeScript",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:types": "vitest typecheck --run test/result.test-d.ts",
    "typecheck": "tsc",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "result",
    "maybe",
    "option",
    "monad",
    "typescript",
    "error-handling",
    "functional",
    "either",
    "oxide"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/semyonf/camtschaticus.git"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.10",
    "@tsconfig/node20": "20.1.9",
    "@tsconfig/strictest": "2.0.8",
    "tsup": "8.0.0",
    "typescript": "5.9.3",
    "vitest": "3.0.0"
  }
}
