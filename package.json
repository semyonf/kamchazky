{
  "name": "@semyonf/kamchazky",
  "version": "1.1.0",
  "author": "Semyón <taxnuke@gmail.com>",
  "homepage": "https://github.com/semyonf/kamchazky#readme",
  "bugs": {
    "url": "https://github.com/semyonf/kamchazky/issues"
  },
  "description": "Type-safe Result and Maybe monads for TypeScript. Explicit error handling and optional values with full type inference. No exceptions required.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./eslint": {
      "import": {
        "types": "./dist/eslint.d.ts",
        "default": "./dist/eslint.js"
      },
      "require": {
        "types": "./dist/eslint.d.cts",
        "default": "./dist/eslint.cjs"
      },
      "default": "./dist/eslint.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:types": "vitest typecheck --run test/result.test-d.ts test/maybe.test-d.ts",
    "typecheck": "tsc",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check",
    "prepublishOnly": "npm run build",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "keywords": [
    "result",
    "maybe",
    "option",
    "monad",
    "typescript",
    "error-handling",
    "functional",
    "either",
    "oxide"
  ],
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@typescript-eslint/utils": ">=8.0.0",
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "@typescript-eslint/utils": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/semyonf/kamchazky.git"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.10",
    "@changesets/cli": "^2.31.0",
    "@tsconfig/node20": "20.1.9",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "^20.19.43",
    "@typescript-eslint/parser": "8.62.1",
    "@typescript-eslint/rule-tester": "8.62.1",
    "@typescript-eslint/utils": "8.62.1",
    "eslint": "9.31.0",
    "tsup": "8.0.0",
    "typescript": "5.9.3",
    "vitest": "3.0.0"
  }
}
