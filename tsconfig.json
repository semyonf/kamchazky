{
  "extends": [
    "@tsconfig/node20/tsconfig.json",
    "@tsconfig/strictest/tsconfig.json"
  ],
  "compilerOptions": {
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "test"],
  // A consumer of the built package: test/dist.test.ts compiles it after
  // the build, with its own tsconfig.
  "exclude": ["test/consumer"]
}
